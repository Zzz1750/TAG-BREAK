---
import Layout from '../layouts/Layout.astro';

---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed - TagBreak</title>
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        
        body {
            background-color: #f2f2f2;
            color: rgb(28, 28, 28);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            line-height: 1.6;
        }
        
        .container {
            max-width: 500px;
            width: 100%;
            text-align: center;
            padding: 40px 30px;
            position: relative;
        }
        
        .logo-container {
            position: relative;
            width: 130px;
            height: 130px;
            margin: 0 auto 40px;
        }
        
        .timer-circle {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
        
        .timer-circle-bg {
            fill: none;
            stroke: rgba(0, 0, 0, 0.08);
            stroke-width: 1.5;
        }
        
        .timer-circle-progress {
            fill: none;
            stroke: #000000;
            stroke-width: 1.5;
            stroke-linecap: round;
            transition: stroke-dashoffset 0.05s linear;
        }
        
        .logo {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100px;
            height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            padding: 20px;
        }
        
        .logo img {
            width: 100%;
            height: auto;
            object-fit: contain;
            transform: rotate(-55deg);
        }
        
        h1 {
            font-size: 2.2rem;
            margin-bottom: 15px;
            font-weight: 700;
            color: #000000;
            letter-spacing: -0.5px;
        }
        
        .subtitle {
            font-size: 1.3rem;
            margin-bottom: 30px;
            color: black;
            font-weight: 500;
        }
        
        .message-box {
            background-color: rgba(69, 69, 69, 0.08);
            border-radius: 12px;
            padding: 25px;
            margin: 25px 0;
            text-align: left;
            border: 1px solid rgba(57, 57, 57, 0.15);
        }
        
        .message-box p {
            margin-bottom: 15px;
            line-height: 1.7;
        }
        
        .message-box p:last-child {
            margin-bottom: 0;
        }
        
        .highlight {
            color: #000000;
            font-weight: 600;
        }
        
        .footer {
            margin-top: 40px;
            font-size: 1rem;
            color: #000000;
        }
        
        .footer p {
            margin-bottom: 8px;
        }
        
        .brand {
            font-weight: 600;
            text-decoration: underline;
            color: #000000;
        }
        
        .divider {
            height: 1px;
            background: linear-gradient(to right, transparent, rgba(55, 55, 55, 0.3), transparent);
            margin: 25px 0;
        }
        
        .redirecting {
            margin-top: 15px;
            font-size: 0.85rem;
            color: #666;
            font-style: italic;
        }
        
        @media (max-width: 600px) {
            .container {
                padding: 30px 20px;
            }
            
            .logo-container {
                width: 110px;
                height: 110px;
                margin-bottom: 35px;
            }
            
            .logo {
                width: 85px;
                height: 85px;
                padding: 17px;
            }
            
            h1 {
                font-size: 1.9rem;
            }
            
            .subtitle {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>
    <Layout>
    <div class="container">
        <div class="logo-container">
            <svg class="timer-circle" viewBox="0 0 100 100">
                <!-- Background circle -->
                <circle class="timer-circle-bg" cx="50" cy="50" r="45"></circle>
                <!-- Progress circle - will be animated via JavaScript -->
                <circle class="timer-circle-progress" cx="50" cy="50" r="45"></circle>
            </svg>
            
            <div class="logo">
                <img src="/images/logo3.png" alt="TagBreak Logo">
            </div>
        </div>
        
        <h1>Your Break Starts Now</h1>
        <p class="subtitle">Order successfully placed!</p>
        
        <div class="divider"></div>
        
        <div class="message-box">
            <p>Thank you for your purchase! Your order has been successfully requested and is being processed.</p>
            <p>This is a <span class="highlight">once-only batch item</span>. We use a request-to-purchase step to ensure everything stays genuine and safe for each of our buyers.</p>
            <p>You'll receive a confirmation email shortly with your order details.</p>
        </div>
        
        <div class="redirecting">You will be redirected shortly...</div>
        
        <div class="footer">
            <p>Have a wonderful day! :)</p>
            <p>Team <span class="brand">TagBreak</span></p>
        </div>
    </div>

    <script>
              // @ts-nocheck

        const progressCircle = document.querySelector('.timer-circle-progress');
        const redirectUrl = '/';
        
        // Calculate circle circumference
        const radius = 45;
        const circumference = 2 * Math.PI * radius;
        
        // Initialize the circle - starting from the top (12 o'clock position)
        progressCircle.style.strokeDasharray = circumference;
        progressCircle.style.strokeDashoffset = circumference;
        
        // Rotate the circle to start from top (default SVG starts from 3 o'clock)
        // We rotate 90 degrees counter-clockwise to start from top
        document.querySelector('.timer-circle').style.transform = 'rotate(-90deg)';
        
        let startTime;
        const duration = 10000; 
        
        function animateCircle(timestamp) {
            if (!startTime) startTime = timestamp;
            
            const elapsed = timestamp - startTime;
            const progress = Math.min(elapsed / duration, 1);
            
            // Animate from full to empty (stroke-dashoffset goes from circumference to 0)
            const offset = circumference - (progress * circumference);
            progressCircle.style.strokeDashoffset = offset;
            
            if (progress < 1) {
                // Continue animation
                requestAnimationFrame(animateCircle);
            } else {
                // Animation complete - redirect
                setTimeout(() => {
                    window.location.href = redirectUrl;
                }, 50); // Small delay to ensure circle is fully visible
            }
        }
        
        // Start the animation when page loads
        document.addEventListener('DOMContentLoaded', function() {
            // Start the smooth animation
            requestAnimationFrame(animateCircle);
            
            // Backup redirect after 10.1 seconds
            setTimeout(function() {
                window.location.href = redirectUrl;
            }, 10100);
        });
        
        // Allow manual click to redirect immediately
        document.addEventListener('click', function() {
            window.location.href = redirectUrl;
        });
    </script>
    </Layout>
</body>
</html>