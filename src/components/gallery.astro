    transform: translate(-50%, -50%);
    padding: 12px 24px;
    border: 1px solid rgba(0, 0, 0, 0.6);
    background-color: transparent;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all 300ms ease;
    font-family: 'aldrich';
    pointer-events: auto;
  }
  
  #set3_button:hover {
    border-color: rgba(0, 0, 0, 0.8);
    background-color: rgba(0, 0, 0, 0.05);
    transform: translate(-50%, -50%) scale(1.05);
  }

  
  @keyframes riseIn {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) translateY(0);
    }
  }
  
  @keyframes riseOut {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) translateY(0);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) translateY(-20px);
    }
  }

  @media (max-width: 768px) {
    #set2_head {
      font-size: 2.5rem;
    }

    #set2_shead{
      font-size: 1.5rem;
    }
    
    #set2_content{
      font-size: 0.6rem;
    }
    
    #set2_content2{
      font-size: 0.8rem;
    }
    
    #go_left_button{
      top: 88%;
      left: 80%;
      width: 6%;
    }
    
    #go_right_button{
      top: 88%;
      left: 20%;
      width: 6%;
    }
    
    #set3_theme {
      font-size: 1.5rem;
      padding: 0 15px;
    }
  }

  @media (max-width: 550px) {
    #set2_head {
      font-size: 2.3rem;
    }
    
    #set2_shead{
      font-size: 1.3rem;
    }
    
    #set3_theme {
      font-size: 1.2rem;
      padding: 0 10px;
    }
    
    #set3_button {
      padding: 10px 20px;
      font-size: 0.7rem;
    }
  }

  #loading_screen {
    background-color: #1e4941;
    position: fixed;
    inset: 0; 
    width: 100vw;
    height: 100vh;
    z-index: 9999;
  }
  #loading_asset1{
    position: absolute;
    width: 50px;
    top: 43%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  #loading_asset2{
    position: absolute;
    top: 43%;
    left: 50%;
    width: 300px;
    transform: translate(-50%, -50%);
    display: none;
  }
</style>

<body>
  <div id="loading_screen">
    <img src="/TAG-BREAK//images/logo3.png" id="loading_asset1" alt="">
    <img src="/TAG-BREAK//images/pink_logo.webp" id="loading_asset2" alt="">
  </div>
  <div id="set2">
    <div id="shifter_div"></div>
    <div id="set2_first_liner">
      <h2 id="set2_head"> <span id="set2_shead">The</span>Break Gallery</h2>
      <p id="set2_content">Step Into the World of Tagbreak Scarves</p>
      <p id="set2_content2">See Gallery →</p>
    </div>
  </div>

  <div id="set3" style="display: none;">
    <img src="/TAG-BREAK/images/icon/gallery_next.png" id="go_right_button" class="common_arrow" alt="" draggable="false">
    <img src="/TAG-BREAK/images/icon/gallery_next.png" id="go_left_button" class="common_arrow" alt="" draggable="false">
    <h2 id="set3_theme"></h2>
    <button id="set3_button">See Theme</button>
  </div>

  <a-scene background="color: #d6d6d6" display="none">
    <a-entity light="type: ambient; intensity: 0.55"></a-entity>
    <a-entity a-entity light="intensity: 1.3" position="2 7.30212 2.52619"></a-entity>
    <a-entity light="intensity: 0.9" position="0 7.60557 -1.05818"></a-entity>
    <a-entity light="type: spot; intensity: 0.4; angle: 40; distance: 0" position="-1.31538 7.79688 3.76431" rotation="-26.317670403744103 0 0"></a-entity>
    
    <!-- Camera -->
    <a-entity id="camrig" position="0 1.6 3">
      <a-camera look-controls="enabled: false" wasd-controls="enabled: false"></a-camera>
    </a-entity>

    <!-- Assets -->
    <a-assets>
      <a-asset-item id="scarf1" src="/TAG-BREAK/3D-models/scarf1.glb"></a-asset-item>
      <a-asset-item id="scarf2" src="/TAG-BREAK/3D-models/scarf2.glb"></a-asset-item>
      <a-asset-item id="scarf3" src="/TAG-BREAK/3D-models/scarf3.glb"></a-asset-item>
      <a-asset-item id="scarf4" src="/TAG-BREAK/3D-models/scarf4.glb"></a-asset-item>
      <a-asset-item id="scarf5" src="/TAG-BREAK/3D-models/scarf5.glb"></a-asset-item>
    </a-assets>

    <a-entity id="scarf_main_rig" position="0 1 -6" auto-rotate> 
      <a-entity id="scarf_arrangement" position="0 0 0">
        
        <!-- SCARF 1 - Front (0°) -->
        <a-entity id="scarf1_container" position="0 0 -4">
          <a-entity id="scarf1" gltf-model="#scarf5" rotation="10 0 0" position="0 3 0" scale="1.5 1.5 1.5" animation-mixer="clip: *; loop: repeat; timeScale: 1.5">
            <a-image src="/TAG-BREAK//3D-models/shadow.png" position="0 -1.71397 -0.05" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="90 0 0"></a-image>    
          </a-entity>
        </a-entity>

        <!-- SCARF 2 - Right Front (72°) -->
        <a-entity id="scarf2_container" rotation="0 72 0">
          <a-entity position="0 0 -4">
            <a-entity id="scarf2" gltf-model="#scarf2" position="0 3 0" scale="1.5 1.5 1.5"  animation-mixer="clip: *; loop: repeat; timeScale: 1" rotation="10 0 0">
              <a-image src="/TAG-BREAK//3D-models/shadow.png" position="0 -1.71397 -0.05" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="90 0 0"></a-image>    
            </a-entity>
          </a-entity>
        </a-entity>

        <!-- SCARF 3 - Right Back (144°) -->
        <a-entity id="scarf3_container" rotation="0 144 0">
          <a-entity position="0 0 -4">
            <a-entity id="scarf3" gltf-model="#scarf1" position="0 3 0" scale="1.5 1.5 1.5"  animation-mixer="clip: *; loop: repeat; timeScale: 0.5" rotation="10 0 0">
              <a-image src="/TAG-BREAK//3D-models/shadow.png" position="0 -1.71397 -0.05" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="90 0 0"></a-image>    
            </a-entity>
          </a-entity>
        </a-entity>

        <!-- SCARF 4 - Left Front (-72° or 288°) -->
        <a-entity id="scarf4_container" rotation="0 -72 0">
          <a-entity position="0 0 -4">
            <a-entity id="scarf4" gltf-model="#scarf3" position="0 3 0" scale="1.5 1.5 1.5"  animation-mixer="clip: *; loop: repeat; timeScale: 1" rotation="10 0 0">
              <a-image src="/TAG-BREAK//3D-models/shadow.png" position="0 -1.71397 -0.05" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="90 0 0"></a-image>    
            </a-entity>
          </a-entity>
        </a-entity>

        <!-- SCARF 5 - Left Back (-144° or 216°) -->
        <a-entity id="scarf5_container" rotation="0 -144 0">
          <a-entity position="0 0 -4">
            <a-entity id="scarf5" gltf-model="#scarf4" position="0 3 0" scale="1.5 1.5 1.5"  animation-mixer="clip: *; loop: repeat; timeScale: 0.8" rotation="10 0 0">
              <a-image src="/TAG-BREAK//3D-models/shadow.png" position="0 -1.71397 -0.05" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="90 0 0"></a-image>    
            </a-entity>
          </a-entity>
        </a-entity>

      </a-entity>
    </a-entity>
  </a-scene>
</body>