<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Visions in Motion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aldrich&family=Cinzel+Decorative:wght@400;700;900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="/images/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <script is:inline src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/gh/donmccurdy/aframe-extras@6.1.1/dist/aframe-extras.min.js"></script>

    <script is:inline>
    /* =========================
       MEMORY MONITORING
    ========================= */
    const memory = {
      used: 0,
      limit: 1200, // MB (safe mobile threshold)
      warned: false
    };

    function checkMemory() {
      if (!performance.memory) return;

      memory.used = Math.round(
        performance.memory.usedJSHeapSize / 1048576
      );

      if (memory.used > memory.limit && !memory.warned) {
        memory.warned = true;
        console.warn("⚠️ High memory usage:", memory.used, "MB");
        forceCleanup();
      }
    }

    /* =========================
       FORCED CLEANUP
    ========================= */
    function forceCleanup() {
      console.warn("🧹 Forcing cleanup...");

      // Stop all A-Frame animations
      document
        .querySelectorAll("[animation], [animation__*]")
        .forEach(el => {
          Object.keys(el.components)
            .filter(c => c.startsWith("animation"))
            .forEach(c => el.removeAttribute(c));
        });

      document
        .querySelectorAll(".dynamic, .temp")
        .forEach(el => el.remove());

      if (AFRAME?.THREE) {
        AFRAME.THREE.Cache.clear();
      }

      if (window.gc) window.gc();
    }

    /* =========================
       MONITOR LOOP
    ========================= */
    setInterval(checkMemory, 5000);

    /* =========================
       CAMERA SLIDER
    ========================= */
    document.addEventListener('DOMContentLoaded', function() {

      document.getElementById('shop_button').addEventListener('click', ()=>{
        window.location.href = '/TAG-BREAK/shop';
      });

      // Camera movement variables
      const camRig = document.getElementById('camrig');
      const cameraSlider = document.getElementById('camera_slider');
      const cameraSliderBtn = document.getElementById('camera_slider_btn');
      
      // Camera position limits - START FROM LEFT (0 is left position)
      const LEFT_POSITION = 0;    // Starting position (left)
      const RIGHT_LIMIT = 15.0;    // Max right movement from left position
      
      // Current camera X position - start at left (0)
      let currentCameraX = LEFT_POSITION;
      
      // Slider dimensions
      let sliderWidth = 300;
      let sliderLeft = 0;
      
      // Update slider dimensions
      function updateSliderDimensions() {
        if (cameraSlider) {
          const rect = cameraSlider.getBoundingClientRect();
          sliderWidth = rect.width - 10;
          sliderLeft = rect.left + 20;
        }
      }
      
      // Initialize slider position to left (default)
      function initializeSlider() {
        updateSliderDimensions();
        // Start at left position (0)
        currentCameraX = LEFT_POSITION;
        updateCameraPosition();
        updateSliderButtonPosition();
      }
      
      // Update camera position
      function updateCameraPosition() {
        if (camRig) {
          const currentPos = camRig.getAttribute('position');
          camRig.setAttribute('position', {
            x: currentCameraX,
            y: currentPos.y,
            z: currentPos.z
          });
        }
      }
      
      // Update slider button position based on camera X
      function updateSliderButtonPosition() {
        if (!cameraSliderBtn) return;
        
        // Convert camera X position to slider percentage
        const percentage = currentCameraX / RIGHT_LIMIT;
        
        // Position button along slider track
        const buttonPos = percentage * sliderWidth;
        cameraSliderBtn.style.left = `${buttonPos}px`;
      }
      
      // Move camera by a specific amount
      function moveCamera(amount) {
        const newX = currentCameraX + amount;
        // Clamp between LEFT_POSITION (0) and RIGHT_LIMIT (2)
        currentCameraX = Math.max(LEFT_POSITION, Math.min(RIGHT_LIMIT, newX));
        updateCameraPosition();
        updateSliderButtonPosition();
      }
      
      // Set camera to specific position (0-100%)
      function setCameraPosition(percentage) {
        const clampedPercentage = Math.max(0, Math.min(1, percentage));
        // Map percentage to position: 0% = 0 (left), 100% = 2 (right)
        currentCameraX = clampedPercentage * RIGHT_LIMIT;
        updateCameraPosition();
        updateSliderButtonPosition();
      }
      
      // Mouse/touch drag functionality
      let isDragging = false;
      
      function startDrag(e) {
        isDragging = true;
        e.preventDefault();
        document.addEventListener('mousemove', doDrag);
        document.addEventListener('touchmove', doDrag);
        document.addEventListener('mouseup', stopDrag);
        document.addEventListener('touchend', stopDrag);
      }
      
      function doDrag(e) {
        if (!isDragging || !cameraSlider) return;
        
        updateSliderDimensions();
        
        // Get client X from mouse or touch
        let clientX;
        if (e.type.includes('touch')) {
          clientX = e.touches[0].clientX;
        } else {
          clientX = e.clientX;
        }
        
        // Calculate new button position
        let newPosition = clientX - sliderLeft;
        newPosition = Math.max(0, Math.min(sliderWidth, newPosition));
        
        // Update button position
        cameraSliderBtn.style.left = `${newPosition}px`;
        
        // Calculate and update camera position
        const percentage = newPosition / sliderWidth;
        setCameraPosition(percentage);
      }
      
      function stopDrag() {
        isDragging = false;
        document.removeEventListener('mousemove', doDrag);
        document.removeEventListener('touchmove', doDrag);
        document.removeEventListener('mouseup', stopDrag);
        document.removeEventListener('touchend', stopDrag);
      }
      
      // Set up event listeners
      if (cameraSliderBtn) {
        // Mouse events
        cameraSliderBtn.addEventListener('mousedown', startDrag);
        cameraSliderBtn.addEventListener('touchstart', startDrag);
        
        // Click on slider track to jump
        cameraSlider.addEventListener('click', function(e) {
          updateSliderDimensions();
          const rect = this.getBoundingClientRect();
          const clickX = e.clientX - rect.left;
          const percentage = (clickX - 20) / sliderWidth;
          setCameraPosition(percentage);
        });
        
        // Touch support for slider track
        cameraSlider.addEventListener('touchstart', function(e) {
          updateSliderDimensions();
          const rect = this.getBoundingClientRect();
          const touchX = e.touches[0].clientX - rect.left;
          const percentage = (touchX - 20) / sliderWidth;
          setCameraPosition(percentage);
        });
      }
      
      // Initialize on load
      window.addEventListener('load', initializeSlider);
      window.addEventListener('resize', initializeSlider);
      
      // Expose for debugging
      window.cameraControls = {
        moveLeft: () => moveCamera(-0.5),
        moveRight: () => moveCamera(0.5),
        reset: () => {
          currentCameraX = LEFT_POSITION;
          updateCameraPosition();
          updateSliderButtonPosition();
        },
        getPosition: () => currentCameraX
      };
    });

    /* =========================
       FORCE REMOVE VR BUTTON
    ========================= */
    document.addEventListener('DOMContentLoaded', function() {
      // Remove immediately
      removeVRButton();
      
      // Remove again after scene loads
      document.querySelector('a-scene').addEventListener('loaded', function() {
        setTimeout(removeVRButton, 100);
        setTimeout(removeVRButton, 500);
      });
      
      // Keep checking to ensure it stays removed
      setInterval(removeVRButton, 1000);
    });

    function removeVRButton() {
      // Remove VR button elements
      const vrElements = document.querySelectorAll(
        '.a-enter-vr, .a-enter-vr-button, .a-enter-ar-button, .vr-mode-ui, [data-awe-vr-mode-ui]'
      );
      vrElements.forEach(el => {
        el.style.display = 'none';
        el.style.visibility = 'hidden';
        el.style.opacity = '0';
        el.style.pointerEvents = 'none';
        if (el.parentNode) el.parentNode.removeChild(el);
      });
      
      // Remove AR button if present
      const arButton = document.querySelector('[ar-button]');
      if (arButton) arButton.remove();
    }


    document.addEventListener('DOMContentLoaded', function(){

      var scarf_main_name = document.getElementById('scarf_main_name');
      var sidebar_image = document.getElementById('sidebar_image');
      var button_location ='';
      var sidebar_container = document.getElementById('sidebar_container');

      document.getElementById('view_product_button').addEventListener('click', ()=>{
        window.location.href = button_location;
      })

      document.getElementById('sidebar_close').addEventListener('click', ()=>{
        sidebar_container.style.display='none'
      })
      
      document.getElementById('scarf1_plane').addEventListener('click', ()=>{
        change_sidebar('High Stakes', '/TAG-BREAK/scarf/Visions_in_Motions/high/High_Stakes_.jpg')
        button_location = '/shop/high-stakes'
      })

      document.getElementById('scarf2_plane').addEventListener('click', ()=>{
        change_sidebar('Blue Reverie', '/TAG-BREAK/scarf/Visions_in_Motions/blue/Blue_Reverie.jpg')
        button_location = '/shop/blue-reverie'
      })

      document.getElementById('scarf3_plane').addEventListener('click', ()=>{
        change_sidebar('Future Gaze', '/TAG-BREAK/scarf/Visions_in_Motions/future/Future_Gaze.jpg')
        button_location = '/shop/future-gaze'
      })

      document.getElementById('scarf4_plane').addEventListener('click', ()=>{
        change_sidebar('Thanos Veil','/TAG-BREAK/scarf/Visions_in_Motions/thanos/Thanos_Veil.jpg')
        button_location = '/shop/thanos-veil'
      })

      document.getElementById('scarf5_plane').addEventListener('click', ()=>{
        change_sidebar('Ignite WIthin', '/TAG-BREAK/scarf/Visions_in_Motions/iginite/Ignite_Within.jpg')
        button_location = '/shop/ignite-within'
      })

      function change_sidebar(new_name, new_img_loc){

        sidebar_container.style.display='block'
        scarf_main_name.innerHTML=new_name;
        sidebar_image.setAttribute('src', new_img_loc)
      }
      
    });


    document.addEventListener('DOMContentLoaded', function(){
      const img1 = document.getElementById('loading_asset1');
      const img2 = document.getElementById('loading_asset2');
      
      let showFirst = true;

      setInterval(() => {
        if (showFirst) {
          img1.style.display = "none";
          img2.style.display = "block";
        } else {
          img1.style.display = "block";
          img2.style.display = "none";
        }
        showFirst = !showFirst;
      }, 1000);
    });



    let loadingComplete = false;

function hideAFrameLoader() {
    const loaders = document.querySelectorAll('.a-loader');
    loaders.forEach(loader => loader.remove());
    
    const scene = document.querySelector('a-scene');
    if (scene && scene.loader) scene.loader.style.display = 'none';
    
    const canvases = document.querySelectorAll('canvas');
    canvases.forEach(canvas => {
        if (canvas.classList && canvas.classList.contains('a-canvas')) {
            canvas.style.visibility = 'visible';
            canvas.style.opacity = '1';
        }
    });
}

function stopLogoAnimation() {
    const img1 = document.getElementById('loading_asset1');
    const img2 = document.getElementById('loading_asset2');
    if (img1) img1.style.display = 'block';
    if (img2) img2.style.display = 'none';
    
    if (window.loadingInterval) {
        clearInterval(window.loadingInterval);
    }
}

function waitForEverything() {
    return new Promise((resolve) => {
        const scene = document.querySelector('a-scene');
        if (!scene) {
            resolve();
            return;
        }

        let sceneLoaded = false;
        let assetsLoaded = false;
        let modelsLoaded = 0;
        const totalModels = document.querySelectorAll('[gltf-model]').length;
        
        const checkComplete = () => {
            if (sceneLoaded && assetsLoaded && modelsLoaded >= totalModels) {
                console.log('Everything loaded');
                resolve();
            }
        };

        if (scene.hasLoaded) {
            sceneLoaded = true;
        } else {
            scene.addEventListener('loaded', () => {
                sceneLoaded = true;
                checkComplete();
            });
        }

        const assets = scene.querySelector('a-assets');
        if (assets) {
            assets.addEventListener('loaded', () => {
                assetsLoaded = true;
                checkComplete();
            });
        } else {
            assetsLoaded = true;
        }

        if (totalModels === 0) {
            modelsLoaded = 0;
            checkComplete();
        } else {
            document.querySelectorAll('[gltf-model]').forEach(model => {
                model.addEventListener('model-loaded', () => {
                    modelsLoaded++;
                    checkComplete();
                });
            });
        }

        setTimeout(() => {
            console.log('Loading timeout - proceeding');
            resolve();
        }, 10000);
    });
}

async function loadEverything() {
    console.log('Loading everything...');
    
    hideAFrameLoader();
    stopLogoAnimation();
    
    await waitForEverything();
    
    const scene = document.querySelector('a-scene');
    if (scene && scene.renderer && scene.renderer.getContext()) {
        scene.render();
    }
    
    await new Promise(resolve => setTimeout(resolve, 500));
    
    showFinalScene();
}

function showFinalScene() {
    if (loadingComplete) return;
    loadingComplete = true;
    
    const loadingScreen = document.getElementById('loading_screen');
    const scene = document.querySelector('a-scene');
    
    if (!loadingScreen) return;
    
    loadingScreen.style.transition = 'opacity 600ms ease';
    loadingScreen.style.opacity = '0';
    
    if (scene) {
        scene.style.display = 'block';
        scene.style.opacity = '1';
        scene.style.visibility = 'visible';
        
        if (scene.render) {
            requestAnimationFrame(() => scene.render());
        }
    }
    
    setTimeout(() => {
        if (loadingScreen && loadingScreen.parentNode) {
            loadingScreen.style.display = 'none';
        }
    }, 600);
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadEverything);
} else {
    loadEverything();
}

window.addEventListener('load', () => {
    if (!loadingComplete) {
        setTimeout(loadEverything, 100);
    }
});

setTimeout(() => {
    if (!loadingComplete) {
        console.log('Final fallback');
        showFinalScene();
    }
}, 15000);
    </script>
    
    <style>
    /* Remove all focus outlines globally */
    *:focus {
        outline: none !important;
        box-shadow: none !important;
    }
    
    /* REMOVE VR BUTTON COMPLETELY */
    .a-enter-vr, 
    .a-enter-vr-button, 
    .a-enter-ar-button,
    .vr-mode-ui,
    [data-awe-vr-mode-ui] {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
    }

    /* Remove any AR/VR related elements */
    .a-enter-vr-modal {
        display: none !important;
    }

    /* Remove the VR button container */
    .a-orientation-modal {
        display: none !important;
    }
    
    /* Specifically target interactive elements */
    .common_arrow:focus {
        outline: none !important;
        border-color: rgba(0, 0, 0, 0.6) !important;
        background-color: transparent !important;
        box-shadow: none !important;
    }

    /* Remove tap highlight on mobile */
    button, img[class*="common"] {
        -webkit-tap-highlight-color: transparent !important;
        -webkit-focus-ring-color: transparent !important;
    }

    /* Remove blue highlight on image click */
    img {
        -webkit-user-select: none;
        -webkit-user-drag: none;
        -webkit-tap-highlight-color: transparent;
    }

    /* Remove selection highlight */
    *::selection {
        background-color: transparent;
    }

    *::-moz-selection {
        background-color: transparent;
    }

    /* For the entire document */
    html, body {
        -webkit-tap-highlight-color: transparent;
        user-select: none;
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    /* Remove any active state styling from A-Frame */
    a-entity:focus,
    a-camera:focus,
    a-scene:focus {
        outline: none !important;
    }

