    margin: 0 0 8px 0;
    line-height: 1.1;
    color: #000000;
    font-weight: 700;
    letter-spacing: -0.3px;
}

/* Theme name */
#scarf_theme_name {
    font-size: 1rem;
    color: rgba(0, 0, 0, 0.65);
    margin: 0 0 25px 0;
    font-style: italic;
    font-weight: normal;
    position: relative;
    display: inline-block;
    padding-bottom: 8px;
}

#scarf_theme_name::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 35px;
    height: 1.5px;
    background: rgba(0, 0, 0, 0.4);
}

/* Product info - simple layout */
.product-info {
    margin: 25px 0 30px 0;
    padding: 0;
    flex-shrink: 0; /* Prevent shrinking */
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

.info-row:last-child {
    border-bottom: none;
}

.info-label {
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.55);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.info-value {
    font-size: 1rem;
    color: #000000;
    font-weight: 500;
}

.info-value.price {
    font-size: 1.4rem;
    font-weight: 700;
}

/* Single action button - ALWAYS AT BOTTOM */
#view_product_button {
    width: 100%;
    padding: 16px;
    background: transparent;
    border: 2px solid #000000;
    font-family: 'Aldrich', sans-serif;
    font-size: 0.9rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
    color: #000000;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.2s ease;
    margin-top: auto; /* This pushes it to the bottom */
    flex-shrink: 0; /* Prevent button from shrinking */
}

#view_product_button:hover {
    background: #000000;
    color: #ffffff;
}

#view_product_button:active {
    transform: translateY(1px);
}

#view_product_button svg {
    width: 18px;
    height: 18px;
}

/* Mobile responsive */
@media (max-width: 768px) {
    #sidebar_container {
        width: 100%;
        height: auto;
        max-height: 90vh;
        bottom: 0;
        top: auto;
        border-left: none;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }
    
    #sidebar_close {
        top: 20px;
        right: 20px;
        width: 28px;
        height: 28px;
    }
    
    #sidebar_content {
        padding: 30px 25px;
        height: 100%; /* Ensure full height */
    }
    
    #sidebar_image_wrapper {
        margin-bottom: 25px;
        max-height: 30vh; /* Limit image height on mobile */
        overflow: hidden;
    }
    
    #sidebar_image {
        height: auto;
        max-height: 30vh;
        object-fit: contain;
    }
    
    #scarf_main_name {
        font-size: 1.8rem;
    }
    
    .info-row {
        padding: 10px 0;
    }
    
    #view_product_button {
        padding: 14px;
        font-size: 0.85rem;
        margin-top: auto; /* Still at bottom */
    }
    
    .product-info {
        margin: 20px 0 25px 0;
    }
}

/* Tablet responsive */
@media (max-width: 1024px) and (min-width: 769px) {
    #sidebar_container {
        width: 380px;
    }
    
    #sidebar_content {
        padding: 35px 30px;
    }
}

/* Extra small devices */
@media (max-width: 400px) {
    #sidebar_content {
        padding: 25px 20px;
    }
    
    #scarf_main_name {
        font-size: 1.6rem;
    }
    
    .product-info {
        margin: 15px 0 20px 0;
    }
}

    #vignette {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 50; /* below UI, above a-scene */

      background: radial-gradient(
        ellipse at center,
        rgba(0,0,0,0) 55%,
        rgba(0,0,0,0.3) 100%
      );
    }

    #loading_screen {
      background-color: #f2f2f2;
      position: fixed;
      inset: 0; 
      width: 100vw;
      height: 100vh;
      z-index: 9999;
    }
    #loading_asset1{
      position: absolute;
      width: 100px;
      top: 43%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-45deg);
    }
    #loading_asset2{
      position: absolute;
      top: 43%;
      left: 50%;
      width: 280px;
      transform: translate(-50%, -50%);
      display: none;
    }

  </style>
</head>
<body>
  <Layout>
  <div id="loading_screen">
    <img src="/images/logo3.png" id="loading_asset1" alt="">
    <img src="/images/new_logo.png" id="loading_asset2" alt="">
  </div>

  <div id="sidebar_container" style="display: none;">
    <!-- Close button -->
    <button id="sidebar_close" aria-label="Close sidebar"></button>
    
    <div id="sidebar_content">
        <!-- Image section -->
        <div id="sidebar_image_wrapper">
            <img src="" 
                 id="sidebar_image" 
                 alt="overload">
        </div>

        <!-- Text content -->
        <div id="sidebar_text_container">
            <h1 id="scarf_main_name"></h1>
            <p id="scarf_theme_name"><i>Visions in Motion</i></p>
            
            <!-- Product info -->
            <div class="product-info">
                <div class="info-row">
                    <span class="info-label">Size</span>
                    <span class="info-value">48cm × 48cm</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Fabric</span>
                    <span class="info-value">Plant-Eco tech</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Price</span>
                    <span class="info-value price">₹1,000</span>
                </div>
            </div>
            
            <!-- Single action button -->
            <button id="view_product_button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                View Product
            </button>
        </div>
    </div>
</div>
    <div id="theme_container">
      <h1 id="theme_head">THEME</h1>
      <h1 id="theme_name">Visions in Motion</h1>
    </div>
    <h1 id="shop_button">Shop</h1>

    <!-- Camera Slider with Arrows -->
    <div id="camera_slider_container">
      <!-- Left Arrow -->
      <div id="left_arrow" class="slider-arrow">
        <img src="/images/icon/arrow2.png" alt="Left Arrow">
      </div>
      
      <!-- Slider Wrapper -->
      <div id="slider_wrapper">
        <div id="camera_slider">
          <div id="camera_slider_btn"></div>
          <div id="camera_slider_label"></div>
        </div>
      </div>
      
      <!-- Right Arrow -->
      <div id="right_arrow" class="slider-arrow">
        <img src="/images/icon/arrow2.png" alt="Right Arrow">
      </div>
    </div>

    <div id="vignette"></div>


    <a-scene background="color: #d6d6d6" vr-mode-ui="enabled: false">
        <a-entity light="type: ambient; intensity: 0.55"></a-entity>
        <a-entity a-entity light="intensity: 1.3" position="-2 7.30212 2.52619"></a-entity>
        <a-entity light="intensity: 0.9" position="0 7.60557 -1.05818"></a-entity>
        <a-entity light="type: spot; intensity: 0.4; angle: 80; distance: 0" position="-1.31538 7.79688 3.76431" rotation="-26.317670403744103 0 0"></a-entity>
      
        <a-entity id="camrig">
            <a-camera  
                position="0 3.2 3" rotation="10 0 0"
                look-controls="enabled: false"
                wasd-controls="enabled: false"
                fov="70">
          </a-camera>
        </a-entity>
      
         <a-entity
          cursor="rayOrigin: mouse"
          raycaster="objects: .clickable">
        </a-entity>

        <!-- 3D Assets -->
        <a-assets>
            <a-asset-item id="scarf1" src="/3D-models/VIM/Ignite_Within.glb"></a-asset-item>
            <a-asset-item id="scarf2" src="/3D-models/VIM/future_gaze.glb"></a-asset-item>
            <a-asset-item id="scarf3" src="/3D-models/VIM/Blue_Reverie.glb"></a-asset-item>
            <a-asset-item id="scarf4" src="/3D-models/VIM/High_Stakes_.glb"></a-asset-item>
            <a-asset-item id="scarf5" src="/3D-models/VIM/Thanos_Veil.glb"></a-asset-item>
        </a-assets>

        <a-entity id="scarf_main_rig" position="0 1 -6" auto-rotate> 
            
            <!-- SCARF 4  -->
            <a-entity id="scarf1_container" position="11 1.3 4">
                <a-entity id="scarf1" gltf-model="#scarf5" rotation="10 -5 -7" position="0 3 0" scale="1.5 1.5 1.5" animation-mixer="clip: *; loop: repeat; timeScale: 0.8">
                <a-image src="/3D-models/shadow.png" position="-0.03989 -2.41091 0.08217" width="2.3" height="1" material="opacity: 0.4" geometry="" rotation="77.8357435107272 18.44293846746607 18.51283931847203" ></a-image>
                  </a-entity>
            </a-entity>

            <!-- SCARF 3  -->
            <a-entity id="scarf2_container" position="7.2 0.2 8.5">
                <a-entity position="0 0 -4">
                    <a-entity id="scarf2" gltf-model="#scarf2" position="0 3 0" scale="1.5 1.5 1.5" animation-mixer="clip: *; loop: repeat; timeScale: 0.8" rotation="10 5 10">
                    <a-image src="/3D-models/shadow.png" position="-0.12077 -1.69459 -0.06054" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="78 -48 -44.76175478680044"></a-image>    
                    </a-entity>      
                </a-entity>
            </a-entity>

            <!-- SCARF 5 -->
            <a-entity id="scarf3_container" position="14.5 -0.5 8">
                <a-entity position="0 0 -4">
                    <a-entity id="scarf3" gltf-model="#scarf1" position="0 3 0" scale="1.5 1.5 1.5" animation-mixer="clip: *; loop: repeat; timeScale: 0.8" rotation="10 0 10">
                        <a-image src="/3D-models/shadow.png" position="0 -1.6 -0.05" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="75 -44 -43"></a-image>    
                    </a-entity>
                </a-entity>
            </a-entity>

            <!-- SCARF 2  -->
            <a-entity id="scarf4_container" position="3.5 1.5 8.2">
                <a-entity position="0 0 -4">
                    <a-entity id="scarf4" gltf-model="#scarf3" position="0 3 0" scale="1.5 1.5 1.5" animation-mixer="clip: *; loop: repeat; timeScale: 0.8" rotation="5 0 0">
                    <a-image src="/3D-models/shadow.png" position="0.044 -2.6 -0.30382" width="2.3" height="1" material="opacity: 0.4" geometry="" rotation="95 11 13.02455"></a-image>                    
                  </a-entity>
                </a-entity>
            </a-entity>

            

            <!-- SCARF 1 -->
            <a-entity id="scarf5_container" position="0 0.5 7.9">
                <a-entity position="0 -0.8 -4">
                    <a-entity id="scarf5" gltf-model="#scarf4" position="0 3 0" scale="1.5 1.5 1.5" animation-mixer="clip: *; loop: repeat; timeScale: 0.8" rotation="10 -10 0">
                        <a-image src="/3D-models/shadow.png" position="0 -1.7 -0.05" width="2.3" height="1" material="transparent: true; opacity: 0.4" geometry="" rotation="90 0 0"></a-image>    
                    </a-entity>
                </a-entity>
            </a-entity>
        </a-entity>

        <!-- Clickable planes for scarves -->
        <a-plane id="scarf1_plane" class="clickable" color="white" material="transparent: true; opacity: 0" geometry="" position="0 3.737 -1.88265" rotation="6.45 -6.189 0.725" scale="3.2 3.2 1"></a-plane>
        <a-plane id="scarf2_plane" class="clickable" color="white" material="transparent: true; opacity: 0" geometry="" position="3.534 5.514 -1.669" rotation="5 0 0" scale="3.2 3.2 1"></a-plane>
        <a-plane id="scarf3_plane" class="clickable" color="white" material="transparent: true; opacity: 0" geometry="" position="7.248 4.215 -1.247" rotation="6 0 10" scale="3 3 1"></a-plane>
        <a-plane id="scarf4_plane" class="clickable" color="white" material="transparent: true; opacity: 0" geometry="" position="10.8 5.35282 -1.89" rotation="6 -3.94 -5" scale="3.5 3 1"></a-plane>        
        <a-plane id="scarf5_plane" class="clickable" color="white" material="transparent: true; opacity: 0" geometry="" position="14.44496 3.65115 -1.89" rotation="8.86 -3.94 10" scale="3 3 1"></a-plane>    
</a-scene>
</Layout>
</body>
</html>