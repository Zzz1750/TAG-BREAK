    width: 100%;
    position: relative;
    margin-bottom: 35px;
    border-radius: 0;
    overflow: hidden; /* Changed from visible to hidden */
    border: none;
}

#sidebar_image {
    width: 100%;
    height: auto;          
    object-fit: contain;  
    display: block;
}

/* Text content - FLEX COLUMN */
#sidebar_text_container {
    width: 100%;
