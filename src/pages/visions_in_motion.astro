    /* =========================
       CAMERA SLIDER STYLES
    ========================= */
    #camera_slider_container {
      z-index: 100;
      position: absolute;
      bottom: 120px;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 400px;
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
    }

    /* Arrow styles */
    .slider-arrow {
      width: 18px;
      height: 18px;
      display: flex;
      opacity: 0.5;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      pointer-events: auto;
      transition: opacity 0.2s ease;
      user-select: none;
    }

    .slider-arrow:hover {
      opacity: 0.8;
    }

    .slider-arrow img {
      width: 100%;
      object-fit: contain;
    }

    #left_arrow {
      transform: rotate(180deg);
    }

    #slider_wrapper {
      display: flex;
      align-items: center;
      flex: 1;
      max-width: 300px;
    }

    #camera_slider {
      z-index: 100;
      position: relative;
      width: 100%;
      height: 0px;
      background: rgba(255, 255, 255, 0);
      border-radius: 5px;
      border: 1px solid rgba(0, 0, 0, 0.1);
      cursor: pointer;
      overflow: visible;
      flex: 1;
    }

    #camera_slider_btn {
      z-index: 100;
      position: absolute;
      top: 50%;
      left: 0;
      transform: translate(-50%, -50%);
      width: 20px;
      height: 20px;
      background: rgba(255, 255, 255, 0);
      border: 1.5px solid rgba(0, 0, 0, 0.5);
      border-radius: 50%;
      cursor: grab;
      user-select: none;
      touch-action: none;
    }

    #camera_slider_btn:active {
      cursor: grabbing;
    }

    #camera_slider_label {
      z-index: 100;
      position: absolute;
      bottom: -35px;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(0, 0, 0, 0.8);
      font-family: Arial, sans-serif;
      font-size: 12px;
      font-weight: bold;
      text-align: center;
      white-space: nowrap;
      pointer-events: none;
    }

    /* Slider track indicators */
    #camera_slider::before,
    #camera_slider::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 2px;
      height: 15px;
      background: rgba(0, 0, 0, 0);
      transform: translateY(-50%);
      border-radius: 2px;
    }

    #camera_slider::before {
      left: 10px;
    }

    #camera_slider::after {
      right: 10px;
    }

    /* =========================
       RESPONSIVE STYLES
    ========================= */
