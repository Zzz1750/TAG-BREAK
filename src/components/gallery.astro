---
import Loader from '../components/loading.astro'
---


<script is:inline src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/gh/donmccurdy/aframe-extras@6.1.1/dist/aframe-extras.min.js"></script>

<script is:inline>
  // State management
  const state = {
    currentIndex: 0,
    isRotating: false,
    isTransitioning: false,
    hasEnteredGallery: false,
    themes: [
      "Visions in Motions",
      "Geometric Rhythms",
      "Celestial Wave",
      "Raw Manifesto",
      "Threads of Mind"
    ]
  };

  // DOM elements
  let themeElement, leftArrow, rightArrow, set3Button, set2Content2;

  // Memory monitoring
  let memoryCheckInterval;
  let lastMemoryUsage = 0;
  
  function startMemoryMonitoring() {
    memoryCheckInterval = setInterval(() => {
      if (window.performance && performance.memory) {
        const usedMB = performance.memory.usedJSHeapSize / (1024 * 1024);
        console.log(`Memory usage: ${usedMB.toFixed(2)} MB`);
        
        if (lastMemoryUsage > 0 && usedMB > lastMemoryUsage * 1.5) {
          console.warn('Memory spike detected, forcing cleanup');
          forceCleanup();
        }
        
        lastMemoryUsage = usedMB;
      }
    }, 5000);
  }
  
  function forceCleanup() {
    const scene = document.querySelector('a-scene');
    if (!scene) return;
    
    const newScene = scene.cloneNode(true);
    scene.parentNode.replaceChild(newScene, scene);
    
    setTimeout(() => {
      if (scene.parentNode) {
        scene.parentNode.removeChild(scene);
      }
      
      const canvases = document.querySelectorAll('canvas');
      canvases.forEach(canvas => {
        if (canvas.width) canvas.width = 0;
        if (canvas.height) canvas.height = 0;
        canvas.getContext = () => null;
      });
    }, 100);
  }

  // Animation utilities
  function animateFadeOut(element, duration = 500) {
    return new Promise(resolve => {
      element.style.transition = `opacity ${duration}ms ease, transform ${duration}ms ease`;
      element.style.opacity = '0';
      element.style.transform = 'translate(-50%, -50%) translateY(10px)';
      
      setTimeout(() => {
        element.style.display = 'none';
        resolve();
      }, duration);
    });
  }

  function animateFadeIn(element, duration = 500, delay = 0) {
    return new Promise(resolve => {
      element.style.display = 'block';
      element.style.opacity = '0';
      element.style.transform = 'translate(-50%, -50%) translateY(20px)';
      element.style.transition = 'none';
      
      setTimeout(() => {
        element.style.transition = `opacity ${duration}ms ease ${delay}ms, transform ${duration}ms ease ${delay}ms`;
        element.style.opacity = '1';
        element.style.transform = 'translate(-50%, -50%) translateY(0)';
        
        setTimeout(resolve, duration + delay);
      }, 10);
    });
  }

  function animateRiseFadeOut(element, duration = 500) {
    return new Promise(resolve => {
      element.style.transition = `opacity ${duration}ms ease, transform ${duration}ms ease`;
      element.style.opacity = '0';
      element.style.transform = 'translate(-50%, -50%) translateY(-20px)';
      
      setTimeout(() => {
        element.style.display = 'none';
        resolve();
      }, duration);
    });
  }

  // REMOVED: Dropdown functions

  // Rotation functions
  function rotateGallery(direction) {
    if (state.isRotating || state.isTransitioning) return;
    
    state.isRotating = true;
    const rig = document.querySelector('#scarf_main_rig');
    
    // Calculate new rotation
    const currentRotation = rig.getAttribute('rotation') || { x: 0, y: 107, z: 0 };
    const rotationStep = 72; // 360 / 5 scarves
    const newY = currentRotation.y + (rotationStep * direction);
    
    // Update theme index
    if (direction === 1) {
      state.currentIndex = (state.currentIndex + 1) % state.themes.length;
    } else {
      state.currentIndex = (state.currentIndex - 1 + state.themes.length) % state.themes.length;
    }
    
    // Animate theme text with rise effect
    animateThemeTransition();
    
    // Perform rotation
    rig.setAttribute('animation__rotate', {
      property: 'rotation',
      to: `0 ${newY} 0`,
      dur: 800,
      easing: 'easeInOutCubic',
      startEvents: 'rotate-start'
    });
    
    rig.emit('rotate-start');
    
    // Re-enable rotation after animation
    setTimeout(() => {
      state.isRotating = false;
    }, 800);
  }

  async function animateThemeTransition() {
    if (!themeElement || state.isTransitioning) return;
    
    state.isTransitioning = true;
    
    // Rise and fade out current text
    await animateRiseFadeOut(themeElement, 300);
    
    // Update text content
    themeElement.textContent = `- ‎${state.themes[state.currentIndex]}‎ -`;
    
    // Rise up fade in new text
    await animateFadeIn(themeElement, 400, 0);
    
    state.isTransitioning = false;
  }

  // Initialize gallery
  function initGallery() {
    themeElement = document.getElementById('set3_theme');
    leftArrow = document.getElementById('go_left_button');
    rightArrow = document.getElementById('go_right_button');
    set3Button = document.getElementById('set3_button');
    
    if (leftArrow && rightArrow) {
      leftArrow.addEventListener('click', () => rotateGallery(-1));
      rightArrow.addEventListener('click', () => rotateGallery(1));
      
      // Add keyboard support
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') rotateGallery(-1);
        if (e.key === 'ArrowRight') rotateGallery(1);
      });
    }
    
    // Initialize theme text with fade in
    if (themeElement) {
      themeElement.style.opacity = '0';
      themeElement.style.transform = 'translate(-50%, -50%) translateY(20px)';
      setTimeout(() => {
        themeElement.style.transition = 'opacity 600ms ease, transform 600ms ease';
        themeElement.style.opacity = '1';
        themeElement.style.transform = 'translate(-50%, -50%) translateY(0)';
        themeElement.textContent = `- ‎${state.themes[state.currentIndex]}‎ -`;
      }, 100);
    }
    
    // Add hover effect to set3 button
    if (set3Button) {
      set3Button.addEventListener('mouseenter', () => {
        set3Button.style.transition = 'all 300ms ease';
        set3Button.style.transform = 'translate(-50%, -50%) scale(1.05)';
        set3Button.style.borderColor = 'rgba(0, 0, 0, 0.8)';
      });
      
      set3Button.addEventListener('mouseleave', () => {
        set3Button.style.transform = 'translate(-50%, -50%) scale(1)';
        set3Button.style.borderColor = 'rgba(0, 0, 0, 0.6)';
      });
    }
  }

  // Enhanced fade functions with promises
  function fadeColor(element, duration = 2000) {
    return new Promise(resolve => {
      element.style.backgroundColor = element.style.backgroundColor || 'rgba(214,214,214,0)';
      let start = 0;
      const target = 1;
      const step = 16 / duration;

      function animate() {
        start += step;
        if (start > target) {
          start = target;
          element.style.backgroundColor = `rgba(214, 214, 214, ${start})`;
          resolve();
          return;
        }
        element.style.backgroundColor = `rgba(214, 214, 214, ${start})`;
        requestAnimationFrame(animate);
      }
      animate();
    });
  }

  function fadeOut(element, duration = 1000) {
    return new Promise(resolve => {
      let opacity = parseFloat(getComputedStyle(element).opacity);

      function animate() {
        opacity -= 16 / duration;
        if (opacity < 0) {
          opacity = 0;
          element.style.opacity = opacity;
          resolve();
          return;
        }
        element.style.opacity = opacity;
        requestAnimationFrame(animate);
      }
      animate();
    });
  }

  // Enhanced scene transition with sequential animations
async function call_set3() {
  // Prevent multiple triggers
  if (state.hasEnteredGallery) return;
  state.hasEnteredGallery = true;
  
  const set2FirstLiner = document.getElementById('set2_first_liner');
  const set2Head = document.getElementById('set2_head');
  const set2Content = document.getElementById('set2_content');
  const set2Content2 = document.getElementById('set2_content2');
  
  // FADE OUT BUTTON IMMEDIATELY (moved this up!)
  if (set2Content2) {
    set2Content2.style.transition = 'opacity 800ms ease, transform 800ms ease';
    set2Content2.style.opacity = '0';
    set2Content2.style.transform = 'translate(-50%, -50%) translateY(10px)';
  }
  
  // Start background fade
  await fadeColor(document.getElementById("shifter_div"), 1500);
  
  // Animate text elements sequentially with delays
  if (set2Head) {
    set2Head.style.transition = 'opacity 400ms ease, transform 400ms ease';
    set2Head.style.opacity = '0';
    set2Head.style.transform = 'translate(-50%, -50%) translateY(-10px)';
  }
  
  if (set2Content) {
    setTimeout(() => {
      set2Content.style.transition = 'opacity 400ms ease, transform 400ms ease';
      set2Content.style.opacity = '0';
      set2Content.style.transform = 'translate(-50%, -50%) translateY(-10px)';
    }, 100);
  }
  
  // REMOVED: The button fade-out from here since we moved it up
  
  // Complete the transition
  setTimeout(async () => {
    set2FirstLiner.style.display = 'none';
    const rig = document.querySelector('#scarf_main_rig');
    const cam = document.querySelector('#camrig');

    // Show set3 with initial hidden state for animation
    const set3 = document.getElementById('set3');
    set3.style.display = 'block';
    set3.style.opacity = '0';
    
    // Remove auto-rotate and animate to starting position
    rig.removeAttribute('auto-rotate');
    
    rig.setAttribute('animation__reset', {
      property: 'rotation',
      to: '0 107 0',
      dur: 1500,
      easing: 'easeOutCubic'       
    });

    // Fade out shifter and fade in set3
    await Promise.all([
      fadeOut(document.getElementById("shifter_div"), 2000),
      new Promise(resolve => {
        setTimeout(() => {
          set3.style.transition = 'opacity 800ms ease';
          set3.style.opacity = '1';
          setTimeout(resolve, 800);
        }, 500);
      })
    ]);

    // Hide set2 after animations complete
    document.getElementById('set2').style.display = 'none';
    
    // Initialize gallery with animations
    initGallery();

    // Camera animation
    cam.setAttribute('animation__move', {
      property: 'position',
      to: '0 2 2',
      dur: 1500,
      easing: 'easeOutCubic'
    });
  }, 800);
}

  // A-Frame components
  AFRAME.registerComponent("auto-rotate", {
    tick: function (time, delta) {
      const rot = this.el.getAttribute("rotation");
      rot.y += delta * 0.01; 
      this.el.setAttribute("rotation", rot);
    }
  });

  // Event listeners
  document.addEventListener("DOMContentLoaded", () => {
    // Initial text animations
    const set2Head = document.getElementById('set2_head');
    const set2Content = document.getElementById('set2_content');
    set2Content2 = document.getElementById('set2_content2');
    
    // REMOVED: Create and append dropdown
    
    // Set initial state for all elements
    if (set2Head) {
      set2Head.style.opacity = '0';
      set2Head.style.transform = 'translate(-50%, -50%) translateY(20px)';
    }
    
    if (set2Content) {
      set2Content.style.opacity = '0';
      set2Content.style.transform = 'translate(-50%, -50%) translateY(20px)';
    }
    
    if (set2Content2) {
      set2Content2.style.opacity = '0';
      set2Content2.style.transform = 'translate(-50%, -50%) translateY(20px)';
      set2Content2.style.cursor = 'pointer';
      set2Content2.style.pointerEvents = 'auto';
      
      // CHANGED: Add click handler to call_set3 instead of dropdown
      set2Content2.addEventListener('click', call_set3);
    }
    
    // REMOVED: Close dropdown when clicking elsewhere
    
    // Animate after a short delay with staggered timing
    setTimeout(() => {
      if (set2Head) {
        set2Head.style.transition = 'opacity 800ms ease, transform 800ms ease';
        set2Head.style.opacity = '1';
        set2Head.style.transform = 'translate(-50%, -50%) translateY(0)';
      }
      
      if (set2Content) {
        setTimeout(() => {
          set2Content.style.transition = 'opacity 800ms ease, transform 800ms ease';
          set2Content.style.opacity = '0.5';
          set2Content.style.transform = 'translate(-50%, -50%) translateY(0)';
        }, 300);
      }
      
      if (set2Content2) {
        setTimeout(() => {
          set2Content2.style.transition = 'opacity 800ms ease, transform 800ms ease';
          set2Content2.style.opacity = '1';
          set2Content2.style.transform = 'translate(-50%, -50%) translateY(0)';
        }, 600);
      }
    }, 500);
    
    // Add click handler to set3 button
    const set3Button = document.getElementById('set3_button');
    if (set3Button) {
      set3Button.addEventListener('click', () => {
        console.log('Theme button clicked');
      });
    }
    
    // REMOVED: TOUCH ANYWHERE TO ENTER GALLERY
    // REMOVED: Add click/touch listener to entire set2 div
    
    // REMOVED: Also make shifter_div clickable
    
    // Start memory monitoring
    setTimeout(startMemoryMonitoring, 2000);
  });

  // Cleanup on exit
  window.addEventListener('beforeunload', () => {
    clearInterval(memoryCheckInterval);
    forceCleanup();
  });

  document.addEventListener('DOMContentLoaded', function(){
    const img1 = document.getElementById('loading_asset1');
    const img2 = document.getElementById('loading_asset2');
    
    let showFirst = true;

    setInterval(() => {
      if (showFirst) {
        img1.style.display = "none";
        img2.style.display = "block";
      } else {
        img1.style.display = "block";
        img2.style.display = "none";
      }
      showFirst = !showFirst;
    }, 1000);
    });



    // Wait for A-Frame to be fully ready (scene, assets, renderer)
function waitForAFrameComplete() {
  return new Promise((resolve) => {
    const scene = document.querySelector('a-scene');
    
    if (!scene) {
      console.error('A-Frame scene not found');
      resolve();
      return;
    }

    // Array to track all promises
    const promises = [];

    // 1. Wait for scene to initialize
    promises.push(new Promise(resolveScene => {
      if (scene.hasLoaded) {
        resolveScene();
        return;
      }
      scene.addEventListener('loaded', resolveScene);
    }));

    // 2. Wait for renderer to be ready
    promises.push(new Promise(resolveRenderer => {
      const checkRenderer = () => {
        if (scene.renderer && scene.renderer.getContext()) {
          console.log('WebGL renderer ready');
          resolveRenderer();
        } else {
          setTimeout(checkRenderer, 100);
        }
      };
      checkRenderer();
    }));

    // 3. Wait for all assets to load
    promises.push(new Promise(resolveAssets => {
      const assets = scene.querySelector('a-assets');
      if (!assets) {
        resolveAssets();
        return;
      }

      assets.addEventListener('loaded', resolveAssets);
      
      // Also check if already loaded
      if (assets.hasAttribute('timeout') || assets.children.length === 0) {
        resolveAssets();
      }
    }));

    // 4. Wait for all GLTF models
    promises.push(new Promise(resolveModels => {
      const models = document.querySelectorAll('[gltf-model]');
      let modelsToLoad = models.length;
      
      if (modelsToLoad === 0) {
        resolveModels();
        return;
      }

      console.log(`Waiting for ${modelsToLoad} models to load...`);
      
      models.forEach(model => {
        model.addEventListener('model-loaded', () => {
          modelsToLoad--;
          console.log(`Model loaded, ${modelsToLoad} remaining`);
          
          if (modelsToLoad === 0) {
            console.log('All models loaded');
            resolveModels();
          }
        });
        
        // Fallback: Check mesh directly
        const checkModel = setInterval(() => {
          const mesh = model.getObject3D('mesh');
          if (mesh && mesh.children.length > 0) {
            modelsToLoad--;
            clearInterval(checkModel);
            
            if (modelsToLoad === 0) {
              console.log('All models ready via direct check');
              resolveModels();
            }
          }
        }, 500);
      });
    }));

    // 5. Wait for animation mixer and other components
    promises.push(new Promise(resolveComponents => {
      if (typeof AFRAME === 'undefined') {
        resolveComponents();
        return;
      }

      // Check for animation-mixer component
      const checkComponents = setInterval(() => {
        const modelsWithAnim = document.querySelectorAll('[animation-mixer]');
        let allAnimationsReady = true;
        
        if (modelsWithAnim.length === 0) {
          clearInterval(checkComponents);
          resolveComponents();
          return;
        }

        modelsWithAnim.forEach(model => {
          const mixer = model.components['animation-mixer'];
          if (!mixer || !mixer.mixer) {
            allAnimationsReady = false;
          }
        });

        if (allAnimationsReady) {
          clearInterval(checkComponents);
          console.log('All animation components ready');
          resolveComponents();
        }
      }, 200);
    }));

    // Wait for ALL promises
    Promise.all(promises)
      .then(() => {
        console.log('A-Frame completely ready');
        resolve();
      })
      .catch(error => {
        console.warn('Error in A-Frame loading:', error);
        resolve(); // Resolve anyway to prevent blocking
      });

    // Absolute timeout
    setTimeout(() => {
      console.warn('A-Frame loading timeout - forcing proceed');
      resolve();
    }, 15000); // 15 second maximum
  });
}

// Hide A-Frame's built-in loader immediately
function hideAFrameLoader() {
  // Try multiple ways to hide A-Frame's loader
  const selectors = [
    '.a-loader',
    '.a-canvas',
    'canvas[data-aframe-canvas]',
    'canvas'
  ];
  
  selectors.forEach(selector => {
    const elements = document.querySelectorAll(selector);
    elements.forEach(el => {
      if (el.classList && el.classList.contains('a-loader')) {
        el.style.display = 'none';
        el.style.visibility = 'hidden';
      }
    });
  });
  
  // Also try to access scene's loader
  const scene = document.querySelector('a-scene');
  if (scene && scene.loader) {
    scene.loader.style.display = 'none';
  }
}

// Main initialization
async function initializeApp() {
  console.log('Starting app initialization...');
  
  // Stop the loading animation immediately
  const loadingInterval = window.setInterval(() => {
    // Stop the logo switching animation
    const img1 = document.getElementById('loading_asset1');
    const img2 = document.getElementById('loading_asset2');
    
    if (img1) img1.style.display = "block";
    if (img2) img2.style.display = "none";
  }, 1000);
  
  // Clear the interval immediately
  clearInterval(loadingInterval);
  
  // Hide A-Frame's loader immediately
  hideAFrameLoader();
  
  // Wait for A-Frame to be completely ready
  await waitForAFrameComplete();
  
  // Ensure WebGL context is ready
  await new Promise(resolve => {
    const scene = document.querySelector('a-scene');
    if (scene && scene.renderer && scene.renderer.getContext()) {
      console.log('WebGL context confirmed');
      resolve();
    } else {
      setTimeout(resolve, 500);
    }
  });
  
  // Remove loading screen with smooth fade
  const loadingScreen = document.getElementById('loading_screen');
  if (loadingScreen) {
    console.log('Removing loading screen...');
    
    loadingScreen.style.transition = 'opacity 1000ms ease, visibility 1000ms ease';
    loadingScreen.style.opacity = '0';
    loadingScreen.style.visibility = 'hidden';
    
    setTimeout(() => {
      loadingScreen.style.display = 'none';
      console.log('Loading screen removed');
      
      // Show the A-Frame scene
      const scene = document.querySelector('a-scene');
      if (scene) {
        scene.style.display = 'block';
        scene.style.visibility = 'visible';
        scene.style.opacity = '1';
      }
      
      // Force a render to ensure everything displays
      if (scene && scene.render) {
        setTimeout(() => {
          scene.render();
        }, 100);
      }
      
      // Start your app
      console.log('App ready - all assets loaded');
      
    }, 1000);
  }
}

// Start when everything is ready
if (document.readyState === 'complete') {
  initializeApp();
} else {
  window.addEventListener('load', initializeApp);
}

</script>
<style>
  /* Remove all focus outlines globally */
*:focus {
    outline: none !important;
    box-shadow: none !important;
}

/* Specifically target interactive elements */
.common_arrow:focus,
#set3_button:focus,
#go_left_button:focus,
#go_right_button:focus {
    outline: none !important;
    border-color: rgba(0, 0, 0, 0.6) !important;
    background-color: transparent !important;
    box-shadow: none !important;
}

/* Remove tap highlight on mobile */
button, img[class*="common"], #set3_button {
    -webkit-tap-highlight-color: transparent !important;
    -webkit-focus-ring-color: transparent !important;
}

/* Remove blue highlight on image click */
img {
    -webkit-user-select: none;
    -webkit-user-drag: none;
    -webkit-tap-highlight-color: transparent;
}

/* Remove selection highlight */
*::selection {
    background-color: transparent;
}

*::-moz-selection {
    background-color: transparent;
}

/* For the entire document */
html, body {
    -webkit-tap-highlight-color: transparent;
    user-select: none;
}

/* Remove any active state styling from A-Frame */
a-entity:focus,
a-camera:focus,
a-scene:focus {
    outline: none !important;
}
